FROM node:22-bookworm-slim AS build
WORKDIR /site
COPY src/ForensicEdu.ClientApp/package.json src/ForensicEdu.ClientApp/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/ForensicEdu.ClientApp/ ./
# Same-origin requests are forwarded to the API by Nginx.
# This explicitly overrides any .env.production setting during compilation.
ENV VITE_API_URL=/api
RUN npm run build

FROM nginx:stable-alpine AS runtime
RUN apk add --no-cache ca-certificates
COPY deploy/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /site/dist/ /usr/share/nginx/html/
EXPOSE 8081
CMD ["nginx", "-g", "daemon off;"]
